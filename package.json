{
  "name": "@octri-dev/headscale-unofficial-demo-sdk",
  "description": "Unofficial demo TypeScript SDK for Headscale, generated by Octri from its public API specification.",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octri-dev/headscale-typescript-unofficial-demo-sdk.git"
  },
  "homepage": "https://octri-pg7rnxxaa9ve.octri.dev/",
  "bugs": {
    "url": "https://github.com/octri-dev/headscale-typescript-unofficial-demo-sdk/issues"
  },
  "keywords": [
    "headscale",
    "api-client",
    "octri",
    "unofficial-sdk",
    "demo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "oxfmt --check src test/*.mjs",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.4.0"
  }
}
